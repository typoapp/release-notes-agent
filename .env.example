# LLM provider — pick one and fill in its key
RN_LLM_PROVIDER=anthropic        # anthropic | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repo           # e.g. acme/backend

# JIRA (Cloud requires email + API token for Basic Auth)
JIRA_EMAIL=you@yourorg.com
JIRA_TOKEN=
JIRA_URL=https://yourorg.atlassian.net

# Slack (optional — only needed if formats includes slack)
SLACK_WEBHOOK=

# Usage examples:
#   Daily standup notes (last 24 hours):
#     releasenotes generate --since 24h
#
#   Between two git tags:
#     releasenotes generate --from-tag v1.0.0 --to-tag v1.1.0
#
#   Run the scheduler (8am weekdays by default):
#     releasenotes schedule
